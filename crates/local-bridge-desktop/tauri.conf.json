{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Bridge Desktop Dev",
  "version": "0.1.0",
  "identifier": "com.eaopen.localbridge.desktop.dev",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Local Bridge · 管理中心",
        "width": 1000,
        "height": 740,
        "minWidth": 760,
        "minHeight": 560,
        "visible": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false
  }
}
